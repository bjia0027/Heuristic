# 边缘案例节点Dockerfile
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    gcc g++ make \
    distcc \
    python3 python3-pip \
    htop stress-ng \
    curl wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install psutil requests flask

WORKDIR /app

COPY scripts/node_simulator.py /app/
COPY scripts/distcc_node.py /app/
COPY scripts/load_generator.py /app/

RUN mkdir -p /etc/distcc

ENV DISTCC_HOSTS="localhost"
ENV DISTCC_JOBS="1"

EXPOSE 3632 8080

COPY scripts/start_edge_case.sh /app/start.sh
RUN chmod +x /app/start.sh

CMD ["/app/start.sh"]
