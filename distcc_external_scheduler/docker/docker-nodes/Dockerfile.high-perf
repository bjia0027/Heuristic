# 高性能节点Dockerfile
FROM ubuntu:22.04

# 安装必要软件
RUN apt-get update && apt-get install -y \
    gcc g++ make \
    distcc \
    python3 python3-pip \
    htop stress-ng \
    curl wget \
    && rm -rf /var/lib/apt/lists/*

# 安装Python依赖
RUN pip3 install psutil requests flask

# 创建工作目录
WORKDIR /app

# 复制节点模拟脚本
COPY scripts/node_simulator.py /app/
COPY scripts/distcc_node.py /app/
COPY scripts/load_generator.py /app/

# 创建distcc配置
RUN mkdir -p /etc/distcc

# 设置环境变量
ENV DISTCC_HOSTS="localhost"
ENV DISTCC_JOBS="8"

# 暴露端口
EXPOSE 3632 8080

# 启动脚本
COPY scripts/start_high_perf.sh /app/start.sh
RUN chmod +x /app/start.sh

CMD ["/app/start.sh"]
